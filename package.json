{
  "name": "nativox-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "construir": "tsc -b && vite build",
    "probar": "vitest run",
    "revisar": "npm run revisar:formato && npm run revisar:lint && npm run revisar:tipos && npm run probar && npm run revisar:muerto && npm run revisar:duplicado && npm run verificar-copia",
    "revisar:formato": "prettier --check .",
    "revisar:lint": "eslint .",
    "revisar:tipos": "tsc -b",
    "revisar:muerto": "knip",
    "revisar:duplicado": "jscpd",
    "formatear": "prettier --write .",
    "sincronizar": "node scripts/sincronizar-copia.ts",
    "verificar-copia": "node scripts/verificar-copia.ts",
    "deploy": "npm run construir && wrangler deploy",
    "tipos": "wrangler types servidor/env.d.ts"
  },
  "dependencies": {
    "@browsermt/bergamot-translator": "0.4.9",
    "@huggingface/transformers": "4.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.4.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.59.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "jscpd": "5.3.2",
    "knip": "6.38.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.138.0"
  },
  "prettier": {
    "printWidth": 100
  },
  "knip": {
    "entry": [
      "scripts/*.ts"
    ],
    "project": [
      "{navegador,scripts,servidor,contratos-landing}/**/*.{ts,tsx}"
    ],
    "ignore": [
      "navegador/copia-modulos/**",
      "servidor/env.d.ts"
    ],
    "ignoreDependencies": [
      "@browsermt/bergamot-translator",
      "tailwindcss",
      "cloudflare"
    ]
  },
  "jscpd": {
    "path": [
      "navegador",
      "scripts",
      "servidor",
      "contratos-landing"
    ],
    "format": [
      "typescript",
      "tsx"
    ],
    "ignore": [
      "**/copia-modulos/**",
      "**/env.d.ts"
    ],
    "minLines": 5,
    "minTokens": 50,
    "exitCode": 1,
    "reporters": [
      "console"
    ]
  }
}
